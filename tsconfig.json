{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "DOM", "DOM.Iterable", "ES2020" ],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": [ "wp-content/mu-plugins/currency-converter/src" ]
}